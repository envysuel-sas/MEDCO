# Copie en `.env.local` pour le développement.
# En CI, la valeur vient de la variable de dépôt `VITE_URL_WORKER`
# (Settings → Secrets and variables → Actions → Variables).

# Worker de rappel Cloudflare. Laisser vide tant qu'il n'est pas déployé :
# l'application fonctionne alors avec la seule couche calendrier, et le dit.
# Même origine que l'application : le Worker est monté sous /rappels.
VITE_URL_WORKER=https://medco.boes-home.com/rappels
