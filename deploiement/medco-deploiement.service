# /etc/systemd/system/medco-deploiement.service
# Déclenché à la main ou par un timer : `systemctl start medco-deploiement`.

[Unit]
Description=Déploiement de MEDCO
After=network-online.target

[Service]
Type=oneshot
User=medco
WorkingDirectory=/opt/medco
Environment=VITE_URL_WORKER=https://medco.boes-home.com/rappels
ExecStart=/opt/medco/scripts/deployer.sh /srv/medco
