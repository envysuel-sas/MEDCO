# Serveur statique de MEDCO, derrière le tunnel cloudflared.
#
# Il n'écoute que sur la boucle locale : c'est `cloudflared` qui l'expose, et
# aucun port n'est ouvert sur la box. Cloudflare termine le TLS à la
# périphérie, ce serveur parle donc en clair sur 127.0.0.1.

:8080 {
	root * /srv/medco
	encode gzip zstd
	file_server

	# ⚠ SPA. Le routeur de l'application gère /pilulier, /reglages,
	# /produits/<id>… Sans ce repli, une URL profonde ou un rechargement
	# renverrait 404. C'est aussi ce qui manque à GitHub Pages.
	try_files {path} /index.html

	# ⚠ SQLite WASM ne démarre pas si le .wasm n'est pas servi avec son type :
	# `WebAssembly.instantiateStreaming` refuse tout autre `Content-Type`.
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	@manifeste path *.webmanifest
	header @manifeste Content-Type application/manifest+json

	# ⚠ Les bundles catalogue sont **pré-compressés**. Ils doivent être servis
	# tels quels, en octets bruts : c'est l'application qui décompresse et qui
	# vérifie l'empreinte SHA-256 de la base. Poser `Content-Encoding` ici
	# ferait décompresser le navigateur en chemin.
	@bundles path /bundles/*
	header @bundles {
		Content-Type application/octet-stream
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Le service worker et le manifest ne se mettent pas en cache : sans quoi
	# une mise à jour n'atteint jamais un appareil déjà installé.
	@volatil path /sw.js /registerSW.js /manifest.webmanifest /index.html
	header @volatil Cache-Control "no-cache"

	# Les fichiers empreintés par Vite, eux, sont immuables.
	@empreintes path /assets/* /polices/*
	header @empreintes Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Aucune télémétrie, aucune ressource tierce : tout est servi d'ici.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}
}
